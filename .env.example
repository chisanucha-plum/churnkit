# ===== APPLICATION SETTINGS =====
APP_NAME=Customer Churn Prediction System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# ===== DATABASE SETTINGS =====
# PostgreSQL Configuration (uncomment to use PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/churn_db
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_POOL_TIMEOUT=30
# DATABASE_ECHO=False

# SQLite Configuration (default)
SQLITE_DB_PATH=./data/churn.db
CONNECTION_RETRY_COUNT=3
CONNECTION_RETRY_DELAY=1

# ===== API SETTINGS =====
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30
API_KEY_HEADER=X-API-Key
API_KEYS=your-api-key-1,your-api-key-2,your-api-key-3
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_IP=1000

# ===== LOGGING SETTINGS =====
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
MASK_PII_IN_LOGS=True

# ===== MODEL SETTINGS =====
MODEL_PATH=./models
MODEL_VERSION=v1.0.0
BEST_MODEL_NAME=lightgbm_model.pkl
PREPROCESSING_CONFIG_PATH=./config/preprocessing_config.json
FEATURE_ENGINEERING_CONFIG_PATH=./config/feature_engineering_config.json

# ===== DATA SETTINGS =====
DATA_PATH=./data
TRAIN_TEST_SPLIT_RATIO=0.8
RANDOM_STATE=42
STRATIFY_BY_CHURN=True

# ===== LLM SETTINGS =====
# OpenRouter Configuration
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-2-70b-chat

# Google Gemini Configuration (alternative)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key

# Ollama Configuration (local)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434

# ===== MONITORING SETTINGS =====
ENABLE_MONITORING=True
PROMETHEUS_PORT=9090
ENABLE_TRACING=True
JAEGER_HOST=localhost
JAEGER_PORT=6831

# ===== SECURITY SETTINGS =====
ENABLE_HTTPS=False
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# ===== FEATURE FLAGS =====
ENABLE_BATCH_PREDICTION=True
ENABLE_SHAP_EXPLANATION=True
ENABLE_LLM_INSIGHTS=True
ENABLE_MODEL_DRIFT_DETECTION=True
ENABLE_DATA_QUALITY_MONITORING=True
